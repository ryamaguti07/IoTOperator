# Segredos do operador. Se ficarem vazios, o container gera e persiste em /data.
JWT_SECRET=
AES_KEY=

# auto: tenta Amazon Bedrock e, sem credencial, usa o interpretador local
# required: só cria contrato se o Bedrock responder
# off: só o interpretador local
BEDROCK_MODE=auto
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Opcional. Não defina vazio no ambiente se for usar a cadeia padrão do SDK.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
